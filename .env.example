# Neon (or any Postgres) connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Resend, for magic-link sign-in emails
RESEND_API_KEY=re_...

# Optional
CRON_SECRET=                # protects /api/cron/keep-alive
NEXT_PUBLIC_SENTRY_DSN=     # client error reporting
OPENAI_API_KEY=             # AI glyph generation
AI_GATEWAY_API_KEY=         # e2e agent steps (npm run test:e2e)
